ymmsl_version: v0.2

description: A macro-meso-micro model, three levels of timelines

models:
  macro_meso_micro_model:
    components:
      macro:
        ports:
          o_i: bc_out
          s: bc_in
        description: ''
      meso:
        ports:
          f_init: init_in
          o_i: bc_out
          s: bc_in
          o_f: final_out
        description: ''
      micro:
        ports:
          f_init: init_in
          o_f: final_out
        description: ''
    conduits:
      macro.bc_out: meso.init_in
      meso.final_out: macro.bc_in
      meso.bc_out: micro.init_in
      micro.final_out: meso.bc_in
